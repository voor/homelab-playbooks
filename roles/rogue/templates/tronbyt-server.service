[Unit]
Description=Tronbyt Server
After=network-online.target
Wants=network-online.target

[Service]
User=ruser
Group=ruser
Restart=on-failure
WorkingDirectory=/home/ruser/tronbyt-server

# Define your desired ports, volumes, and other environment variables here
# Example:
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=America/New_York
Environment=WEB_CONCURRENCY=1
Environment=TRONBYT_HOST=0.0.0.0
Environment=SINGLE_USER_AUTO_LOGIN=1
Environment=PRODUCTION=1
Environment=DATA_DIR=/home/ruser/tronbyt-server/data

ExecStart=/usr/local/bin/tronbyt-server

[Install]
WantedBy=multi-user.target